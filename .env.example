# Copy to `.env.local` and fill in real values. Never commit secrets.

# Neon Postgres (pooled connection recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Neon Auth (Dashboard → Auth → Auth URL)
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth

# Min. 32 characters — generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Optional — adaptive lesson director (Commit 11). Falls back to rules if unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
